# FenixJpCatch Extension — Build-time Cloud Configuration
# Copy this file to `.env.local` (which is gitignored) before running `npm run build:libs` or `npm run build`.
# None of these values are committed to the public repository.

# 1. Firebase Web API Key (Google Cloud Console -> APIs & Services -> Credentials)
#    Security restrictions to configure in Google Cloud Console:
#    - Application restrictions: Websites -> chrome-extension://<YOUR_EXTENSION_ID>/*
#    - API restrictions: Restrict key -> Identity Toolkit API, Token Service API
FENIX_FIREBASE_API_KEY=

# 2. Firebase Project ID & Cloud Functions Region
FENIX_FIREBASE_PROJECT_ID=fenixjpcatch
FENIX_FIREBASE_FUNCTIONS_REGION=asia-northeast1

# Optional: Custom Cloud Functions base URL (e.g., for local Firebase Emulator: http://127.0.0.1:5001/fenixjpcatch/asia-northeast1)
FENIX_FIREBASE_FUNCTIONS_BASE_URL=

# 3. Google OAuth 2.0 Web Client ID (Google Cloud Console -> Credentials -> OAuth 2.0 Client IDs -> Web application)
#    Authorized redirect URIs must include: https://<YOUR_EXTENSION_ID>.chromiumapp.org/
FENIX_GOOGLE_OAUTH_CLIENT_ID=

# 4. Optional: Base64-encoded RSA Public Key to pin the extension ID in local unpacked dev builds.
#    Keep the matching private `.pem` file outside the repository.
FENIX_MANIFEST_PUBLIC_KEY=
